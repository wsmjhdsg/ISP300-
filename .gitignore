# ============================================================
#  AutoISP300 (.gitignore)
#  Python + Tkinter 桌面工具 / PyInstaller 打包
#  规则分组组织, 每组说明"为什么排除"
# ============================================================

# ------------------------------------------------------------
# 一、Python 编译产物与字节码缓存
# 原因: 由 .py 源码自动生成, 平台/解释器相关, 无版本价值且易产生无谓冲突
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ------------------------------------------------------------
# 二、Python 依赖与虚拟环境
# 原因: 体积大(数百 MB)、平台绑定, 应通过 pyproject.toml 重建而非入库
# ------------------------------------------------------------
.venv/
venv/
ENV/
env/
.Python
pip-wheel-metadata/

# ------------------------------------------------------------
# 三、构建与打包产物
# 原因: 可由源码 + build.bat / AutoISP300.spec 完全重新生成;
#       exe 约 70MB 二进制, 入库会让仓库急剧膨胀且无法 diff
# ------------------------------------------------------------
# PyInstaller 中间产物目录
build/
# 交付目录: AutoISP300.exe + 随行 config/ logs/
dist/
*.egg-info/
*.egg
.eggs/

# ------------------------------------------------------------
# 四、运行日志与运行时生成数据
# 原因: 程序运行期持续写入, 内容随环境变化, 属本地状态而非源码
# ------------------------------------------------------------
logs/
*.log
*.log.*

# ------------------------------------------------------------
# 五、测试与静态检查缓存
# 原因: 纯工具缓存, 换环境自动重建
# ------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------
# 六、环境变量与密钥类配置(重要)
# 原因: 可能含账号/密钥/令牌, 一旦入库即永久留存于提交历史, 难以彻底清除。
#       本项目当前未发现此类文件, 此处预先兜底; 占位模板见 *.example
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# ------------------------------------------------------------
# 七、第三方软件的快捷方式 / 本机安装物
# 原因: .lnk 内含原机器绝对路径, 换机即失效; 且属他人软件, 非本项目源码。
#       步序中的 launch 步骤请填写各自机器上的实际路径
# ------------------------------------------------------------
*.lnk

# ------------------------------------------------------------
# 八、编辑器与 IDE 配置
# 原因: 个人开发习惯差异大, 入库会引起无意义改动与冲突
# ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.vim/
*.code-workspace

# ------------------------------------------------------------
# 九、操作系统文件
# 原因: 系统自动生成的缩略图/属性文件, 与项目无关
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ------------------------------------------------------------
# 十、本地工作区与会话数据(非项目源码)
# 原因: .workbuddy/ 为 AI 协作工具的本地记忆/会话目录, 属个人工作痕迹
# ------------------------------------------------------------
.workbuddy/

# ------------------------------------------------------------
# 十一、临时文件
# ------------------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
*.pid

# ============================================================
#  以下内容【保留在版本控制中】, 不在排除范围内, 特此注明:
#  - config/             运行配置: 缺失时程序自动补默认值,
#                        且 README 定位为"随包分发的初始化数据", 故入库
#  - config/*.example    config 各文件的占位模板, 供他人参照格式初始化
#  - config/steps/*.json 各机种步序示例, 便于他人理解步骤 schema
#  - assets/icon.ico     应用图标(打包必需资源)
#  - AutoISP300.spec     PyInstaller 打包描述文件(构建配置, 非产物)
#  - dpi.manifest        Windows DPI 声明(源码级资源)
#  - build.bat           一键打包脚本
#  提示: 本机切换真实产线路径请直接改本地 config/, 此类改动会体现为工作区变更。
# ============================================================
